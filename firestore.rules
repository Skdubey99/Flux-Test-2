rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Handshake test doc for connection testing
    match /test/connection {
      allow read: if true;
    }

    // Global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'surajdubey033@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128
        && data.loginId is string && data.loginId.size() >= 3 && data.loginId.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.role in ['admin', 'user']
        && data.status in ['active', 'suspended']
        && (isAdmin() || data.role == 'user');
    }

    function isValidUserVault(data, expectedUserId) {
      return data.userId == expectedUserId
        && data.loginId is string && data.loginId.size() <= 64;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User account and credentials collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming())
        && (isAdmin() || incoming().role == existing().role);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Partitioned user vaults (transactions, debts, budgets)
    match /vaults/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUserVault(incoming(), userId);
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }
  }
}
